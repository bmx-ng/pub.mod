SuperStrict
Framework BRL.StandardIO
Import Pub.Direct3D11
Import "layouts.cpp"
Extern "C"
 Function d3d11_test_layout:Int(kind:Int,field:Int)
End Extern
Function Check(ok:Int,label:String)
 If Not ok Then Throw label
End Function
Try
 Local v0:D3D11_BUFFER_DESC
 Check(SizeOf(v0)=d3d11_test_layout(0,-1),"sizeof D3D11_BUFFER_DESC")
 Check(Byte Ptr(Varptr v0.ByteWidth)-Byte Ptr(Varptr v0)=d3d11_test_layout(0,0),"offset D3D11_BUFFER_DESC.ByteWidth")
 Check(Byte Ptr(Varptr v0.Usage)-Byte Ptr(Varptr v0)=d3d11_test_layout(0,1),"offset D3D11_BUFFER_DESC.Usage")
 Check(Byte Ptr(Varptr v0.BindFlags)-Byte Ptr(Varptr v0)=d3d11_test_layout(0,2),"offset D3D11_BUFFER_DESC.BindFlags")
 Check(Byte Ptr(Varptr v0.CPUAccessFlags)-Byte Ptr(Varptr v0)=d3d11_test_layout(0,3),"offset D3D11_BUFFER_DESC.CPUAccessFlags")
 Check(Byte Ptr(Varptr v0.MiscFlags)-Byte Ptr(Varptr v0)=d3d11_test_layout(0,4),"offset D3D11_BUFFER_DESC.MiscFlags")
 Check(Byte Ptr(Varptr v0.StructureByteStride)-Byte Ptr(Varptr v0)=d3d11_test_layout(0,5),"offset D3D11_BUFFER_DESC.StructureByteStride")
