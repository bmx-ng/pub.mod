 Check(Byte Ptr(Varptr v9.BorderColor[0])-Byte Ptr(Varptr v9)=d3d11_test_layout(9,7),"offset D3D11_SAMPLER_DESC.BorderColor")
 Check(Byte Ptr(Varptr v9.MinLOD)-Byte Ptr(Varptr v9)=d3d11_test_layout(9,8),"offset D3D11_SAMPLER_DESC.MinLOD")
 Check(Byte Ptr(Varptr v9.MaxLOD)-Byte Ptr(Varptr v9)=d3d11_test_layout(9,9),"offset D3D11_SAMPLER_DESC.MaxLOD")
 Local v10:D3D11_RENDER_TARGET_BLEND_DESC
 Check(SizeOf(v10)=d3d11_test_layout(10,-1),"sizeof D3D11_RENDER_TARGET_BLEND_DESC")
 Check(Byte Ptr(Varptr v10.BlendEnable)-Byte Ptr(Varptr v10)=d3d11_test_layout(10,0),"offset D3D11_RENDER_TARGET_BLEND_DESC.BlendEnable")
